# Copy to .env.local for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Required ---------------------------------------------------------------------

# Supabase project URL (Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key: the publishable key (sb_publishable_...) or the legacy anon key.
# Safe to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional ---------------------------------------------------------------------

# Comma-separated list of emails allowed to use the app. Defence in depth on top of
# disabled sign-ups. Leave empty to allow any account that exists in Supabase Auth.
QUICKSYNC_ALLOWED_EMAILS=

# Server-only secret key (sb_secret_... or the legacy service_role key). Bypasses RLS.
# Needed only by `npm run user:create` and the optional /api/cron/cleanup fallback.
# NEVER prefix it with NEXT_PUBLIC_. Leave it out of Vercel if you use pg_cron only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Push notifications (optional) ------------------------------------------------
# Web Push lets your other devices show a notification (with "Copy code" for one-time
# codes) even when QuickSync is closed. Leave these empty to turn the feature off.
# Generate a key pair once with `npm run push:keys` and keep it: changing it later means
# every device has to turn notifications on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. NEVER prefix it with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
# A contact for the push services (Google, Apple, Mozilla): mailto:you@example.com or
# your site's https:// URL.
VAPID_SUBJECT=

# Shared secret for the optional /api/cron/cleanup fallback (Vercel Cron sends it as a
# Bearer token automatically). Generate one with: openssl rand -hex 32
CRON_SECRET=
